# Copy to .env.local and fill in. Never commit real keys.

# JamBase Data API key (https://data.jambase.com/). Server-side only.
JAMBASE_API_KEY=

# Contact for the MusicBrainz User-Agent header (a URL or email).
# MusicBrainz asks every client to identify itself.
MUSICBRAINZ_CONTACT=https://github.com/brian-kujawski/bandwagon

# Spotify app credentials (https://developer.spotify.com/dashboard), so band names
# on the results page open the band's Spotify page. Server-side only; no user
# sign-in is involved. Without them names open a Spotify search instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local co-bill store (SQLite). Defaults to data/bandwagon.db, which git ignores.
# Use :memory: to keep nothing between restarts.
# BANDWAGON_DB=data/bandwagon.db

# How many of the top linked acts to look up on JamBase so their own shows feed
# "One step further". Each is re-checked at most monthly. 0 turns it off.
# BANDWAGON_EXPAND=5

# JamBase calls allowed per calendar month (UTC). The free tier is 1,000; this
# leaves headroom for scripts. The app stops looking things up at the limit.
# JAMBASE_MONTHLY_BUDGET=900

# How many liked bands get a JamBase check per results-page visit, oldest first.
# BANDWAGON_REFRESH_PER_VISIT=5

# Where "Playing near you" looks: home as "lat,lon" and a straight-line radius in
# miles. Defaults to downtown Detroit, 100 miles.
# BANDWAGON_HOME=42.3314,-83.0458
# BANDWAGON_RADIUS_MILES=100

# Every upcoming concert in that area is pulled from JamBase monthly, up to this
# many calls a month (inside JAMBASE_MONTHLY_BUDGET). BANDWAGON_AREA=off stops it.
# BANDWAGON_AREA_MONTHLY_CALLS=150
# BANDWAGON_AREA=on

# parse.bot subscription to the "concertarchives.org API", for the concert history
# checks on the Your bands page. Credits are limited; every check asks first.
# Next.js expands "$NAME" in these values, even in quotes, so write a "$" in a
# key as "\$". A variable already set in your shell wins over this file.
PARSE_API_KEY=
PARSE_SCRAPER_ID=

# Most credits one history check may spend (2 per page of about 50 shows).
# PARSE_CHECK_MAX_CREDITS=30

# Seconds between parse.bot calls during a check.
# PARSE_CALL_DELAY_SECONDS=10
